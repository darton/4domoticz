[Unit]
Description=Water Counter for Domoticz
After=network.target
After=domoticz.service

[Service]
Environment=PYTHONUNBUFFERED=1
User=pi
WorkingDirectory=/home/pi/domoticzapps/counter
ExecStart=/usr/bin/python /home/pi/domoticzapps/counter/domoticz_water_counter.py
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
